<!doctype html>
<html lang=en>
<head>
<meta charset=utf-8>
<meta name=viewport content='width=device-width,initial-scale=1'>
<title>Venicestudio — project bundle</title>
<style>
:root{--bg:#0d0f0c;--bg2:#12150f;--bg3:#171b13;--line:#252b1d;--line2:#333b26;--fg:#e6efd8;--dim:#8d9a7c;--dim2:#6a7559;--acc:#c8f751;--red:#ff6b5e;--amber:#ffc94d;--green:#8ee85a}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:13px/1.55 ui-monospace,Menlo,Consolas,monospace}
.wrap{max-width:900px;margin:0 auto;padding:16px 15px 50px}
header{border-bottom:1px solid var(--line);padding-bottom:11px;margin-bottom:14px}
h1{font-size:14px;margin:0;letter-spacing:.07em;text-transform:uppercase}.sub{color:var(--dim);font-size:11.5px}
.card{background:var(--bg2);border:1px solid var(--line);border-radius:9px;padding:13px;margin-bottom:13px}
.card h2{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--dim);margin:0 0 8px}
button{font:inherit;font-size:12px;border-radius:6px;border:1px solid var(--line2);background:var(--bg3);color:var(--fg);padding:7px 11px;cursor:pointer;margin-right:7px}
button:hover:not(:disabled){border-color:var(--acc);color:var(--acc)}button:disabled{opacity:.4;cursor:not-allowed}
button.primary{background:var(--acc);border-color:var(--acc);color:#10140a;font-weight:700}
button.mini{padding:2px 7px;font-size:10.5px;margin:0 0 0 6px}
input{width:100%;background:#0a0c08;border:1px solid var(--line2);color:var(--fg);border-radius:6px;padding:8px 9px;font:inherit;font-size:12px}
label{display:block;font-size:11px;color:var(--dim);margin:0 0 4px}
.list{max-height:340px;overflow:auto;font-size:11.5px;border:1px solid var(--line);border-radius:7px;padding:7px}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:3px 0;border-bottom:1px dotted var(--line)}
.row span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.log{background:#070906;border:1px solid var(--line);border-radius:7px;height:200px;overflow:auto;padding:8px;font-size:11.5px;line-height:1.6;white-space:pre-wrap;word-break:break-word}
.log div{display:flex;gap:7px}.t{color:var(--dim2);flex:0 0 auto}
.ok{color:var(--green)}.warn{color:var(--amber)}.err{color:var(--red)}.info{color:var(--dim)}
.note{font-size:11px;color:var(--dim);line-height:1.7;margin:9px 0 0}
.kbd{border:1px solid var(--line2);border-radius:4px;padding:0 4px;font-size:10.5px}
</style>
</head>
<body>
<div class=wrap>
<header><h1>Venicestudio bundle</h1><div class=sub id=sub>loading…</div></header>
<div class=card><h2>Project files</h2>
<div style='margin-bottom:9px'><button class=primary id=zip>Download project .zip</button><button id=pushAll>Push all to repo</button></div>
<div class=list id=list></div>
<p class=note>Save individual files with the buttons, or grab the zip and unzip it — this page runs on a real origin, so both work here.</p></div>
<div class=card><h2>Push</h2><label for=tok>Fine-grained token &mdash; needs Contents: Read and write</label>
<input id=tok type=password spellcheck=false autocomplete=off placeholder='github_pat_...'>
<p class=note>Repo <b id=repoTxt>Ravn420/VenicePrototype</b></p>
<div class=log id=log style='margin-top:9px'><div><span class=t>--:--:--</span><span class=info>idle</span></div></div></div>
</div>
<script type='application/json' id=payload></script>
<script>
(function(){
var R='Ravn420/VenicePrototype',API='https://api.github.com';
var $=function(i){return document.getElementById(i)};var busy=false;
var files=JSON.parse(new TextDecoder().decode(Uint8Array.from(atob($('payload').textContent),function(c){return c.charCodeAt(0)})));
$('sub').textContent=files.length+' files, '+files.reduce(function(a,f){return a+f.body.length},0)+' bytes';
function now(){var d=new Date();return [d.getHours(),d.getMinutes(),d.getSeconds()].map(function(n){return String(n).padStart(2,'0')}).join(':')}
function log(k,t){var r=document.createElement('div');var a=document.createElement('span');a.className='t';a.textContent=now();var m=document.createElement('span');m.className=k;m.textContent=t;r.appendChild(a);r.appendChild(m);$('log').appendChild(r);$('log').scrollTop=$('log').scrollHeight}
function save(blob,name){var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(a.href)},5000)}
var CRC=(function(){var t=new Uint32Array(256);for(var i=0;i<256;i++){var c=i;for(var k=0;k<8;k++)c=c&1?0xEDB88320^(c>>>1):c>>>1;t[i]=c>>>0}return t})();
function crc32(u){var c=0xFFFFFFFF;for(var i=0;i<u.length;i++)c=CRC[(c^u[i])&0xFF]^(c>>>8);return (c^0xFFFFFFFF)>>>0}
function zip(){var enc=new TextEncoder(),p=[],cd=[],off=0;files.forEach(function(f){var n=enc.encode(f.path),d=enc.encode(f.body),c=crc32(d),s=d.length;
var lh=new Uint8Array(30+n.length),dv=new DataView(lh.buffer);dv.setUint32(0,0x04034b50,1);dv.setUint16(4,20,1);dv.setUint32(14,c,1);dv.setUint32(18,s,1);dv.setUint32(22,s,1);dv.setUint16(26,n.length,1);lh.set(n,30);p.push(lh,d);
var ch=new Uint8Array(46+n.length),cv=new DataView(ch.buffer);cv.setUint32(0,0x02014b50,1);cv.setUint16(4,20,1);cv.setUint16(6,20,1);cv.setUint32(16,c,1);cv.setUint32(20,s,1);cv.setUint32(24,s,1);cv.setUint16(28,n.length,1);cv.setUint32(42,off,1);ch.set(n,46);cd.push(ch);off+=lh.length+s});
var cs=cd.reduce(function(a,b){return a+b.length},0),e=new Uint8Array(22),ev=new DataView(e.buffer);ev.setUint32(0,0x06054b50,1);ev.setUint16(8,files.length,1);ev.setUint16(10,files.length,1);ev.setUint32(12,cs,1);ev.setUint32(16,off,1);
save(new Blob(p.concat(cd,[e]),{type:'application/zip'}),'venicestudio.zip')}
files.forEach(function(f){var r=document.createElement('div');r.className='row';var s=document.createElement('span');s.textContent=f.path;
var b1=document.createElement('button');b1.className='mini';b1.textContent='copy';b1.onclick=function(){copy(f.body,b1)};
var b2=document.createElement('button');b2.className='mini';b2.textContent='save';b2.onclick=function(){save(new Blob([f.body],{type:'text/plain'}),f.path.split('/').pop())};
r.appendChild(s);var w=document.createElement('div');w.appendChild(b1);w.appendChild(b2);r.appendChild(w);$('list').appendChild(r)});
function copy(t,btn){var done=function(){if(btn){btn.textContent='copied';setTimeout(function(){btn.textContent='copy'},1200)}};
if(navigator.clipboard)navigator.clipboard.writeText(t).then(done,function(){fb()});else fb();
function fb(){var ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();done()}}
function tok(){return $('tok').value.trim()}
function b64(u){var s='',C=0x8000;for(var i=0;i<u.length;i+=C)s+=String.fromCharCode.apply(null,u.subarray(i,i+C));return btoa(s)}
function req(m,p,b){var h={'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'};if(tok())h.Authorization='Bearer '+tok();if(b)h['Content-Type']='application/json';
return fetch(API+p,{method:m,headers:h,body:b?JSON.stringify(b):undefined}).then(function(r){return r.text().then(function(t){var j=null;try{j=t?JSON.parse(t):null}catch(e){}
log(r.ok?'ok':(r.status<500?'err':'warn'),m+' '+p+' -> '+r.status+(t?'  '+t.slice(0,160).replace(/\s+/g,' '):''));return{status:r.status,ok:r.ok,json:j}})})
.catch(function(e){log('warn',m+' '+p+' -> NO RESPONSE ('+(e&&e.message||'net')+')');throw new Error('noresponse')})}
function pool(a,n,f){var i=0;function w(){if(i>=a.length)return Promise.resolve();var k=i++;return Promise.resolve(f(a[k],k)).then(w)}var ws=[];for(var j=0;j<Math.min(n,a.length);j++)ws.push(w());return Promise.all(ws)}
function diag(){if(!tok()){log('err','paste a token');return Promise.resolve(false)}
return req('GET','/user').then(function(u){if(u.status===401){log('err','401 — token invalid or expired');return false}
if(!u.ok){log('err','/user '+u.status);return false}log('ok','identity '+(u.json&&u.json.login||'?'));
return req('GET','/repos/'+R).then(function(rp){if(rp.status===404){log('err','404 — token cannot see repo');return false}
if(!rp.ok){log('err','repo '+rp.status);return false}
if(rp.json&&rp.json.permissions&&!rp.json.permissions.push){log('err','read-only token');return false}log('ok','access ok');return true})})}
function verify(){return req('GET','/repos/'+R+'/contents/?ref=main').then(function(c){if(!c.ok){log('err','read '+c.status);return}
var n=(c.json||[]).length;log(n>1?'ok':'warn','remote now has '+n+' entries')})}
function push(att,list){att=att||1;list=list||files;var br='main';
return req('GET','/repos/'+R).then(function(rp){if(!rp.ok)throw new Error('repo '+rp.status);br=rp.json.default_branch||'main';return req('GET','/repos/'+R+'/git/ref/heads/'+br)})
.then(function(rf){var par=rf.ok?rf.json.object.sha:null;
return pool(list,5,function(f){return req('POST','/repos/'+R+'/git/blobs',{content:b64(new TextEncoder().encode(f.body)),encoding:'base64'})
.then(function(b){if(!b.ok)throw new Error('blob '+f.path+' '+b.status);return{path:f.path,mode:'100644',type:'blob',sha:b.json.sha}})})
.then(function(en){var tr={tree:en};if(par)tr.base_tree=par;return req('POST','/repos/'+R+'/git/trees',tr)
.then(function(t){if(!t.ok)throw new Error('tree '+t.status);return req('POST','/repos/'+R+'/git/commits',{message:'venicestudio: '+list.length+' files',tree:t.json.sha,parents:par?[par]:[]})})})})
.then(function(c){if(!c.ok)throw new Error('commit '+c.status);return req('PATCH','/repos/'+R+'/git/refs/heads/'+br,{sha:c.json.sha,force:false})})
.then(function(p){if(!p.ok)throw new Error('ref '+p.status);log('ok','pushed '+list.length+' files');return verify()})
.catch(function(e){var m=e&&e.message||'';log('err','failed: '+m);
if(att===1&&/403/.test(m)){var noWf=list.filter(function(f){return f.path.indexOf('.github/')!==0});
if(noWf.length!==list.length){log('warn','retry without .github/');return push(2,noWf)}}})}
$('zip').onclick=zip;
$('pushAll').onclick=function(){if(busy)return;busy=1;log('info','--- diagnostics ---');
diag().then(function(ok){if(!ok){busy=0;return}return push(1).then(function(){busy=0})})};
try{var s=localStorage.getItem('venice-studio.gh3');if(s)$('tok').value=s}catch(e){}
$('tok').addEventListener('input',function(){try{localStorage.setItem('venice-studio.gh3',tok())}catch(e){}})
})();
</script>
</body>
</html>
